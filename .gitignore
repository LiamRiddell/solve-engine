# Intellij
*.iml
.idea

# npm
node_modules

# Environment files. Repo-wide, not just under one subdirectory, so a stray
# root or package-level .env can never be committed. .env.example is the one
# intentional exception and is meant to be tracked.
.env
.env.*
!.env.example

# Exclude sourcemaps
*.map

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# playground (React + shadcn/ui interactive demo)
playground/node_modules
playground/dist
playground/.vite
playground/*.local
playground/*.env

# solve-engine package build output (tsup)
packages/engine/dist

# Testing
coverage/

# V8 profiling logs
isolate-*.log

# Standalone profiler (not part of the project)
benchmarks/preload-globals.cjs
benchmarks/profile-vm.ts

# Docs site (Astro)
docs/node_modules
docs/dist
docs/.astro

# Benchmark output from an ordinary run. Only `npm run bench:baseline`
# writes the tracked baselines under benchmarks/baselines/.
packages/engine/benchmarks/current/
.jest-report.json
