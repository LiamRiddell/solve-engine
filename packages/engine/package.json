{
  "name": "solve-engine",
  "version": "2.26.0",
  "description": "An embeddable expression engine for natural-language calculations: units, currencies, percentages, dates and matrices, with the parsing and evaluation plumbing already built.",
  "keywords": [
    "expression-evaluator",
    "calculator",
    "bytecode-vm",
    "parser",
    "lexer",
    "dsl",
    "markdown",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Liam Riddell",
  "homepage": "https://liamriddell.github.io/solve-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamRiddell/solve-engine.git",
    "directory": "packages/engine"
  },
  "bugs": {
