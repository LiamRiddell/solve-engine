{
  "name": "solve-engine",
  "version": "1.0.0-beta.0",
  "description": "The expression evaluation engine behind Solve \u2014 lexer, parser, bytecode VM, and an extensible package system.",
  "keywords": [
    "expression-evaluator",
    "calculator",
    "bytecode-vm",
    "parser",
    "lexer",
    "dsl",
    "markdown",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Liam Riddell",
  "homepage": "https://liamriddell.github.io/solve-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamRiddell/solve-engine.git",
    "directory": "packages/engine"
  },
  "bugs": {
