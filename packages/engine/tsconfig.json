{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "ES2021.WeakRef", "DOM"],
		"strict": false,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"paths": {
			"@solve-js/*": ["./src/*"]
		},
		// Declared explicitly rather than left to automatic @types discovery.
		// TypeScript 5.9's tsc walks up from this directory and finds @types/node
		// hoisted at the workspace root; TypeScript 7's tsc (`npm run typecheck`)
		// does not, and reports every use of `process` and
		// `Error.captureStackTrace` as an error. Naming the one @types package
		// this source actually needs makes both compilers agree, and makes the
		// dependency visible instead of implied by hoisting.
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/__tests__/**/*"]
}
