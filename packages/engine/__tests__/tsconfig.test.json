{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
"paths": {
                     "@solve-js/*": ["../src/*"],
       "@solve-js-examples/*": ["../examples/*"],
       "@tools/*": ["../tools/*"],
       "test/*": ["./*"]
     },
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "allowJs": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}