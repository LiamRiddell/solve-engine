{
  "name": "solve-engine-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "A Model Context Protocol server for the Solve engine: AI tools evaluate an expression, a document or its checks, with the network off and a fresh engine per call.",
  "license": "MIT",
  "author": "Liam Riddell",
  "homepage": "https://liamriddell.github.io/solve-engine/guide/mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamRiddell/solve-engine.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "solve-mcp": "./dist/solve-mcp.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit --skipLibCheck -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "solve-engine": "^2.41.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
