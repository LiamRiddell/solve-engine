{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM"],
		"strict": false,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"@solve-js/*": ["../engine/src/*"],
			"@solve-js-examples/*": ["../engine/examples/*"]
		}
	},
	"include": ["src/**/*.ts"]
}
