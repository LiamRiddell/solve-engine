{
  "name": "solve-engine-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The solve command: evaluate a Solve expression or document from a shell, and fail a CI job when a document's check lines fail.",
  "license": "MIT",
  "author": "Liam Riddell",
  "homepage": "https://liamriddell.github.io/solve-engine/guide/command-line/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamRiddell/solve-engine.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "solve": "./dist/solve.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit --skipLibCheck -p tsconfig.json"
  },
  "dependencies": {
    "solve-engine": "^2.41.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
