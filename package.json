{
  "name": "solve-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for the Solve expression-evaluation engine, its playground bridge, and the interactive playground.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/engine",
    "setup": "npm run build && npm ci --prefix docs && npm ci --prefix playground",
    "test": "node --expose-gc node_modules/jest/bin/jest.js --logHeapUsage",
    "test:ci": "node --expose-gc node_modules/jest/bin/jest.js --no-coverage --logHeapUsage",
    "test:engine": "node --expose-gc node_modules/jest/bin/jest.js --testPathPattern=\"packages/engine/__tests__/engine\" --no-coverage --logHeapUsage",
    "test:light": "node --expose-gc node_modules/jest/bin/jest.js --no-coverage --logHeapUsage --testPathIgnorePatterns=\"LexerVocabularyFuzz|Fuzz|BreakageTests|LongDocumentRobustness\"",
    "test:full": "node --expose-gc --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.full.config.cjs --no-coverage --runInBand --forceExit --json --outputFile=.jest-report.json",
    "test:coverage": "node --expose-gc --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.coverage.config.cjs --runInBand --forceExit",
    "test:oom": "node --expose-gc --max-old-space-size=4096 node_modules/jest/bin/jest.js --no-coverage --logHeapUsage --testPathPattern=\"BreakageTests\\.|LexerFuzz\\.|LongDocumentRobustness\\.\" --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "npm run typecheck --workspace=packages/engine",
    "verify": "npm run typecheck && npm run test:ci && npm run build && npm run smoke && npm run smoke:bundled",
    "verify:ci": "npm run lint && npm run lint:comments && npm run lint:docs && npm run lint:actions && npm run lint:licenses && npm run audit:deps && npm run typecheck && npm run test:full && npm run lint:stats && npm run build && npm run smoke && npm run smoke:bundled && npm run lint:package && npm run lint:size && npm run lint:units && npm run lint:sidebar && npm run test:consumer",
    "smoke": "node scripts/smoke-package.mjs",
    "smoke:bundled": "node scripts/check-tree-shaking.mjs",
    "test:consumer": "node scripts/consumer-e2e.mjs",
    "lint": "oxlint packages/engine/src packages/engine/__tests__ packages/engine/tools packages/playground-bridge/src scripts",
    "lint:comments": "node scripts/check-comment-style.mjs --all",
    "lint:docs": "node scripts/check-doc-coverage.mjs",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:package": "npx --yes publint@0.3.23 packages/engine && npx --yes @arethetypeswrong/cli@0.18.5 --pack packages/engine --ignore-rules no-resolution",
    "audit:deps": "npm audit --audit-level=high",
    "fuzz": "node scripts/fuzz.mjs",
    "bench": "node --expose-gc --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.bench.config.cjs --runInBand",
    "bench:baseline": "node scripts/bench-baseline.mjs",
    "bench:compare": "node scripts/compare-benchmarks.mjs",
    "verify:all": "npm run verify && npm run build --prefix playground",
    "size": "size-limit",
    "stats:tests": "node scripts/collect-test-stats.mjs",
    "lint:stats": "node scripts/collect-test-stats.mjs --check",
    "lint:sidebar": "node scripts/check-sidebar.mjs",
    "lint:actions": "node scripts/check-action-pins.mjs",
    "stats:size": "node scripts/collect-package-size.mjs",
    "lint:size": "node scripts/collect-package-size.mjs --check",
    "stats:bench": "node scripts/collect-benchmark-stats.mjs",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts && npm run build && npm run test:full && npm run stats:tests && npm run stats:units && npm run stats:size",
    "stats:units": "node scripts/generate-unit-reference.mjs",
    "lint:units": "node scripts/generate-unit-reference.mjs --check"
  },
  "size-limit": [
    {
      "name": "import { ExpressionEngine }",
      "path": "packages/engine/dist/index.js",
      "import": "{ ExpressionEngine }"
    },
    {
      "name": "the whole root entry",
      "path": "packages/engine/dist/index.js"
    }
  ],
  "keywords": [],
  "author": "Liam Riddell",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@jest/globals": "^30.5.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jest": "^30.5.0",
    "mitata": "1.0.34",
    "oxlint": "1.80.0",
    "rollup": "4.63.1",
    "size-limit": "13.0.3",
    "ts-jest": "^29.4.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
