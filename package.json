{
	"name": "solve-workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Workspace root for the Solve expression-evaluation engine, its playground bridge, and the interactive playground.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspace=packages/engine",
		"test": "node --expose-gc node_modules/jest/bin/jest.js --logHeapUsage",
		"test:ci": "node --expose-gc node_modules/jest/bin/jest.js --no-coverage --logHeapUsage",
		"test:engine": "node --expose-gc node_modules/jest/bin/jest.js --testPathPattern=\"packages/engine/__tests__/engine\" --no-coverage --logHeapUsage",
		"test:light": "node --expose-gc node_modules/jest/bin/jest.js --no-coverage --logHeapUsage --testPathIgnorePatterns=\"LexerVocabularyFuzz|Fuzz|BreakageTests|LongDocumentRobustness\"",
		"test:oom": "node --expose-gc --max-old-space-size=4096 node_modules/jest/bin/jest.js --no-coverage --logHeapUsage --testPathPattern=\"BreakageTests\\.|LexerFuzz\\.|LongDocumentRobustness\\.\" --runInBand",
		"test:watch": "jest --watch",
		"typecheck": "npm run typecheck --workspace=packages/engine",
		"verify": "npm run typecheck && npm run test:ci && npm run build && npm run smoke",
		"smoke": "node scripts/smoke-package.mjs",
		"bench": "node --expose-gc node_modules/jest/bin/jest.js --config jest.bench.config.cjs --runInBand",
		"bench:baseline": "node scripts/bench-baseline.mjs",
		"bench:compare": "node scripts/compare-benchmarks.mjs",
		"verify:all": "npm run verify && npm run build --prefix playground"
	},
	"keywords": [],
	"author": "Liam Riddell",
	"license": "MIT",
	"devDependencies": {
		"@jest/globals": "^29.6.2",
		"@types/node": "16.18.39",
		"jest": "^29.6.2",
		"ts-jest": "^29.1.1",
		"tsup": "8.5.1",
		"typescript": "5.1.6"
	}
}
