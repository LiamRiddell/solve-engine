{
	"name": "solve-engine",
	"version": "0.1.0",
	"private": true,
	"description": "The @solve/core expression-evaluation engine, its playground-bridge tooling, and the React demo webapp — extracted from the obsidian-solve monorepo.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspace=packages/core",
		"test": "node --expose-gc ./node_modules/.bin/jest --logHeapUsage",
		"test:ci": "node --expose-gc ./node_modules/.bin/jest --no-coverage --logHeapUsage",
		"test:engine": "node --expose-gc ./node_modules/.bin/jest --testPathPattern=\"packages/core/__tests__/engine\" --no-coverage --logHeapUsage",
		"test:light": "node --expose-gc ./node_modules/.bin/jest --no-coverage --logHeapUsage --testPathIgnorePatterns=\"LexerVocabularyFuzz|Fuzz|BreakageTests|LongDocumentRobustness\"",
		"test:oom": "node --expose-gc --max-old-space-size=4096 ./node_modules/.bin/jest --no-coverage --logHeapUsage --testPathPattern=\"BreakageTests\\.|LexerFuzz\\.|LongDocumentRobustness\\.\" --runInBand",
		"test:watch": "jest --watch",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"keywords": [],
	"author": "Liam Riddell",
	"license": "MIT",
	"devDependencies": {
		"@jest/globals": "^29.6.2",
		"@types/node": "16.18.39",
		"jest": "^29.6.2",
		"ts-jest": "^29.1.1",
		"tsup": "8.5.1",
		"typescript": "5.1.6"
	}
}
