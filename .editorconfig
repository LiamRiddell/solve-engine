# Editor defaults, applied by most editors without a plugin.
# Indent style is 2-space because that is what the codebase actually uses:
# 68.6 percent of indented lines repo-wide, and every file in the playground.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing whitespace is significant in Markdown, where two spaces before a
# newline is a hard line break.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
